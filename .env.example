# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" (or publishable) key — safe in the browser; RLS protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role (or secret) key — SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App secrets ───────────────────────────────────────────────────────────────
# Signs customer table sessions (QR ordering) and realtime topic names. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-string
# Also signs the key in every printed table QR code: changing it means reprinting them.

# Address the table QR codes open (your live site, e.g. https://sufis-cafe.vercel.app).
# Leave empty to use the address the admin page is opened on.
NEXT_PUBLIC_APP_URL=

# Shown on the customer home screen (leave empty to hide / ask staff)
NEXT_PUBLIC_WIFI_NAME=
NEXT_PUBLIC_WIFI_PASSWORD=
# Google review link for "Leave a Review" (Google Business → Ask for reviews → copy link)
NEXT_PUBLIC_REVIEW_URL=
NEXT_PUBLIC_INSTAGRAM=sufis.cafe

# Restaurant timezone for daily reports and bill date filters
RESTAURANT_TIMEZONE=Asia/Kolkata

# ── Used only by scripts/create-admin.mjs (first-time setup) ─────────────────
SEED_RESTAURANT_NAME=Your Restaurant Name
SEED_RESTAURANT_EMAIL=owner@example.com
SEED_RESTAURANT_PHONE=
SEED_RESTAURANT_ADDRESS=
SEED_GST_RATE=5
SEED_CURRENCY=INR
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_TABLE_COUNT=10

# ── Used only by scripts/migrate-from-mongo.mjs ──────────────────────────────
MONGODB_URI=
